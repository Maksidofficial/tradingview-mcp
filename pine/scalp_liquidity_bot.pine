//@version=5
strategy("Liquidity Scalp Bot v2 [LTF]",
     overlay           = true,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 2,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.005,
     slippage          = 1,
     max_bars_back     = 500)

// ═══════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════

grp_liq   = "Liquidity Pools"
liq_lb    = input.int(15,  "Pivot Lookback",       group=grp_liq, minval=5, maxval=50)
max_pools = input.int(3,   "Max Levels to Track",  group=grp_liq, minval=1, maxval=5)
use_pdhl  = input.bool(true, "Use PDH/PDL as Pools", group=grp_liq)

grp_seq   = "Setup Sequence"
min_pen   = input.float(0.10, "Min Sweep Penetration (ATR mult)", group=grp_seq, minval=0.0, step=0.05)
sweep_win = input.int(5,   "Sweep → Displacement Window (bars)", group=grp_seq, minval=1, maxval=10)
retr_win  = input.int(5,   "Displacement → Entry Window (bars)", group=grp_seq, minval=1, maxval=10)
disp_atr  = input.float(1.2, "Displacement Body (ATR mult)",     group=grp_seq, minval=0.5, step=0.1)
ms_lb     = input.int(3,   "Minor Structure Lookback (MSS)",     group=grp_seq, minval=2, maxval=10)
confirm_c = input.bool(true, "Require Bullish/Bearish Close on Entry Bar", group=grp_seq)

grp_flt   = "Filters"
vol_mult  = input.float(1.2, "Volume Mult on Displacement (>avg)", group=grp_flt, minval=1.0, step=0.1)
rsi_hi    = input.float(70,  "Block Longs if RSI Above",           group=grp_flt, minval=50, maxval=90)
rsi_lo    = input.float(30,  "Block Shorts if RSI Below",          group=grp_flt, minval=10, maxval=50)
use_htf   = input.bool(true, "HTF Trend Filter",                   group=grp_flt)
htf_tf    = input.timeframe("15", "HTF Timeframe",                 group=grp_flt)
htf_len   = input.int(50,    "HTF EMA Length",                     group=grp_flt, minval=10, maxval=200)

grp_risk  = "Risk Management"
rr_min    = input.float(2.0, "Min R:R Ratio",             group=grp_risk, minval=1.0, step=0.1)
stop_buf  = input.float(0.25,"Stop Buffer (ATR mult)",    group=grp_risk, minval=0.0, step=0.05)
max_hold  = input.int(6,     "Max Bars to Hold",          group=grp_risk, minval=1, maxval=20)
use_be    = input.bool(true, "Move Stop to Breakeven",    group=grp_risk)
be_trig   = input.float(1.0, "Breakeven Trigger (R mult)",group=grp_risk, minval=0.5, step=0.25)
max_daily = input.int(3,     "Max Trades per Day",        group=grp_risk, minval=1, maxval=10)
max_loss  = input.int(2,     "Stop After N Losses/Day",   group=grp_risk, minval=1, maxval=5)

grp_sess  = "Session Filter"
use_sess  = input.bool(true,           "Enable Session Filter", group=grp_sess)
sess_ny   = input.session("0830-1600", "NY Session",            group=grp_sess)
sess_lon  = input.session("0200-1100", "London Session",        group=grp_sess)

grp_vis   = "Display"
show_lvls = input.bool(true, "Show Liquidity Levels", group=grp_vis)
show_zone = input.bool(true, "Show Entry Zone Box",   group=grp_vis)

// ═══════════════════════════════════════════════════════════
//  CORE SERIES  (all global — consistent calculation)
// ═══════════════════════════════════════════════════════════

atr_val  = ta.atr(14)
avg_vol  = ta.sma(volume, 20)
rsi_val  = ta.rsi(close, 14)
vwap_val = ta.vwap(close)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

htf_ema     = request.security(syminfo.tickerid, htf_tf, ta.ema(close, htf_len), lookahead=barmerge.lookahead_off)
htf_ok_long  = not use_htf or close > htf_ema
htf_ok_short = not use_htf or close < htf_ema

in_session = not use_sess
     or (not na(time(timeframe.period, sess_ny,  "America/New_York")))
     or (not na(time(timeframe.period, sess_lon, "UTC")))

// ═══════════════════════════════════════════════════════════
//  LIQUIDITY POOLS  (pivots + previous day high/low)
// ═══════════════════════════════════════════════════════════

ph = ta.pivothigh(high, liq_lb, liq_lb)
pl = ta.pivotlow(low,  liq_lb, liq_lb)

var bsl_arr = array.new_float(0)  // buy-side liquidity (above price)
var ssl_arr = array.new_float(0)  // sell-side liquidity (below price)

if not na(ph)
    array.unshift(bsl_arr, ph)
    if array.size(bsl_arr) > max_pools
        array.pop(bsl_arr)

if not na(pl)
    array.unshift(ssl_arr, pl)
    if array.size(ssl_arr) > max_pools
        array.pop(ssl_arr)

bsl_near = array.size(bsl_arr) > 0 ? array.get(bsl_arr, 0) : na
ssl_near = array.size(ssl_arr) > 0 ? array.get(ssl_arr, 0) : na

// Minor swing points for market-structure-shift confirmation
mph = ta.pivothigh(high, ms_lb, ms_lb)
mpl = ta.pivotlow(low,  ms_lb, ms_lb)
var float minor_high = na
var float minor_low  = na
if not na(mph)
    minor_high := mph
if not na(mpl)
    minor_low := mpl

// ═══════════════════════════════════════════════════════════
//  SWEEP DETECTION  (current bar, against ALL tracked pools)
// ═══════════════════════════════════════════════════════════

f_sweep_below() =>
    float lvl = na
    if array.size(ssl_arr) > 0
        for i = 0 to array.size(ssl_arr) - 1
            l = array.get(ssl_arr, i)
            if low < l and close > l and (l - low) >= atr_val * min_pen
                lvl := l
                break
    if na(lvl) and use_pdhl and not na(pdl) and low < pdl and close > pdl and (pdl - low) >= atr_val * min_pen
        lvl := pdl
    lvl

f_sweep_above() =>
    float lvl = na
    if array.size(bsl_arr) > 0
        for i = 0 to array.size(bsl_arr) - 1
            l = array.get(bsl_arr, i)
            if high > l and close < l and (high - l) >= atr_val * min_pen
                lvl := l
                break
    if na(lvl) and use_pdhl and not na(pdh) and high > pdh and close < pdh and (high - pdh) >= atr_val * min_pen
        lvl := pdh
    lvl

// Nearest liquidity target on the opposite side
f_target_up() =>
    float t = na
    if array.size(bsl_arr) > 0
        for i = 0 to array.size(bsl_arr) - 1
            l = array.get(bsl_arr, i)
            if l > close and (na(t) or l < t)
                t := l
    if use_pdhl and not na(pdh) and pdh > close and (na(t) or pdh < t)
        t := pdh
    t

f_target_down() =>
    float t = na
    if array.size(ssl_arr) > 0
        for i = 0 to array.size(ssl_arr) - 1
            l = array.get(ssl_arr, i)
            if l < close and (na(t) or l > t)
                t := l
    if use_pdhl and not na(pdl) and pdl < close and (na(t) or pdl > t)
        t := pdl
    t

sweep_low_lvl  = f_sweep_below()   // SSL swept → long setup begins
sweep_high_lvl = f_sweep_above()   // BSL swept → short setup begins

// ═══════════════════════════════════════════════════════════
//  DISPLACEMENT + MARKET STRUCTURE SHIFT
// ═══════════════════════════════════════════════════════════

bull_disp = close > open and (close - open) > atr_val * disp_atr
bear_disp = close < open and (open - close) > atr_val * disp_atr

mss_up   = not na(minor_high) and close > minor_high
mss_down = not na(minor_low)  and close < minor_low

// ═══════════════════════════════════════════════════════════
//  SETUP STATE MACHINE
//  0 = idle · 1 = swept, awaiting displacement · 2 = armed, awaiting retrace
// ═══════════════════════════════════════════════════════════

var int   l_state = 0
var int   l_bar   = 0
var float l_sweep_lvl = na
var float l_sweep_low = na
var float l_zone_top  = na
var float l_zone_bot  = na
var bool  l_vol_ok    = false

var int   s_state = 0
var int   s_bar   = 0
var float s_sweep_lvl  = na
var float s_sweep_high = na
var float s_zone_top   = na
var float s_zone_bot   = na
var bool  s_vol_ok     = false

// --- timeouts ---
if l_state == 1 and bar_index - l_bar > sweep_win
    l_state := 0
if l_state == 2 and bar_index - l_bar > retr_win
    l_state := 0
if s_state == 1 and bar_index - s_bar > sweep_win
    s_state := 0
if s_state == 2 and bar_index - s_bar > retr_win
    s_state := 0

// --- stage 1: sweep detected (re-arms on every fresh sweep) ---
if not na(sweep_low_lvl) and strategy.position_size == 0
    l_state     := 1
    l_bar       := bar_index
    l_sweep_lvl := sweep_low_lvl
    l_sweep_low := low
    s_state     := 0   // opposite setup invalidated

if not na(sweep_high_lvl) and strategy.position_size == 0
    s_state      := 1
    s_bar        := bar_index
    s_sweep_lvl  := sweep_high_lvl
    s_sweep_high := high
    l_state      := 0

// --- stage 2: displacement + structure shift in setup direction ---
if l_state == 1 and bull_disp and mss_up
    l_state    := 2
    l_bar      := bar_index
    l_vol_ok   := volume > avg_vol * vol_mult
    l_zone_top := high[1]          // order block: candle before displacement
    l_zone_bot := low[1]

if s_state == 1 and bear_disp and mss_down
    s_state    := 2
    s_bar      := bar_index
    s_vol_ok   := volume > avg_vol * vol_mult
    s_zone_top := high[1]
    s_zone_bot := low[1]

// Upgrade zone to FVG one bar after displacement, if a gap formed
// (displacement candle is the middle of the 3-bar imbalance)
if l_state == 2 and bar_index == l_bar + 1 and low > high[2]
    l_zone_top := low
    l_zone_bot := high[2]

if s_state == 2 and bar_index == s_bar + 1 and high < low[2]
    s_zone_top := low[2]
    s_zone_bot := high

// ═══════════════════════════════════════════════════════════
//  DAILY GOVERNOR  (trade count + loss cutoff)
// ═══════════════════════════════════════════════════════════

var int trades_today = 0
var int losses_today = 0

if ta.change(time("D")) != 0
    trades_today := 0
    losses_today := 0

if strategy.closedtrades > strategy.closedtrades[1]
    if strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        losses_today += 1

can_trade = trades_today < max_daily and losses_today < max_loss

// ═══════════════════════════════════════════════════════════
//  ENTRY  (stage 3: retracement into zone + all filters)
// ═══════════════════════════════════════════════════════════

long_retrace  = l_state == 2 and bar_index > l_bar
     and low <= l_zone_top and close >= l_zone_bot
     and (not confirm_c or close > open)

short_retrace = s_state == 2 and bar_index > s_bar
     and high >= s_zone_bot and close <= s_zone_top
     and (not confirm_c or close < open)

// Stops beyond the sweep wick / zone extreme, buffered by ATR
long_stop  = math.min(nz(l_sweep_low, low), nz(l_zone_bot, low)) - atr_val * stop_buf
short_stop = math.max(nz(s_sweep_high, high), nz(s_zone_top, high)) + atr_val * stop_buf

long_tgt  = f_target_up()
short_tgt = f_target_down()

long_rr_ok  = not na(long_tgt)  and close > long_stop
     and (long_tgt - close)  / (close - long_stop)  >= rr_min
short_rr_ok = not na(short_tgt) and close < short_stop
     and (close - short_tgt) / (short_stop - close) >= rr_min

long_fire = long_retrace
     and close > vwap_val
     and rsi_val < rsi_hi
     and l_vol_ok
     and htf_ok_long
     and in_session
     and can_trade
     and long_rr_ok
     and strategy.position_size == 0

short_fire = short_retrace
     and close < vwap_val
     and rsi_val > rsi_lo
     and s_vol_ok
     and htf_ok_short
     and in_session
     and can_trade
     and short_rr_ok
     and strategy.position_size == 0

// ═══════════════════════════════════════════════════════════
//  EXECUTION + TRADE MANAGEMENT
// ═══════════════════════════════════════════════════════════

var float saved_stop = na
var float saved_tgt  = na
var float trade_risk = na
var int   bars_held  = 0

if long_fire
    strategy.entry("Long", strategy.long)
    saved_stop   := long_stop
    saved_tgt    := long_tgt
    trade_risk   := close - long_stop
    trades_today += 1
    l_state      := 0

if short_fire
    strategy.entry("Short", strategy.short)
    saved_stop   := short_stop
    saved_tgt    := short_tgt
    trade_risk   := short_stop - close
    trades_today += 1
    s_state      := 0

if strategy.position_size != 0
    bars_held += 1
else
    bars_held := 0

// Breakeven: once price runs be_trig × risk in favor, stop → entry
if strategy.position_size > 0
    if use_be and not na(trade_risk) and high >= strategy.position_avg_price + trade_risk * be_trig
        saved_stop := math.max(saved_stop, strategy.position_avg_price)
    strategy.exit("L_Exit", "Long", stop=saved_stop, limit=saved_tgt)

if strategy.position_size < 0
    if use_be and not na(trade_risk) and low <= strategy.position_avg_price - trade_risk * be_trig
        saved_stop := math.min(saved_stop, strategy.position_avg_price)
    strategy.exit("S_Exit", "Short", stop=saved_stop, limit=saved_tgt)

// Time exit — scalp window expired
if bars_held >= max_hold and strategy.position_size != 0
    strategy.close_all("Time Exit")

// ═══════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════

plot(show_lvls and not na(bsl_near) ? bsl_near : na, "BSL",
     color=color.new(color.blue, 20), style=plot.style_circles)
plot(show_lvls and not na(ssl_near) ? ssl_near : na, "SSL",
     color=color.new(color.red, 20),  style=plot.style_circles)
plot(show_lvls and use_pdhl ? pdh : na, "PDH",
     color=color.new(color.blue, 55), style=plot.style_linebr, linewidth=1)
plot(show_lvls and use_pdhl ? pdl : na, "PDL",
     color=color.new(color.red, 55),  style=plot.style_linebr, linewidth=1)
plot(vwap_val, "VWAP", color=color.new(color.orange, 0), linewidth=2)

// Entry zone box while a setup is armed
var box l_box = na
var box s_box = na

if show_zone and l_state == 2 and na(l_box)
    l_box := box.new(bar_index, l_zone_top, bar_index + retr_win, l_zone_bot,
         border_color=color.new(color.green, 40), bgcolor=color.new(color.green, 85))
if l_state != 2 and not na(l_box)
    box.delete(l_box)
    l_box := na

if show_zone and s_state == 2 and na(s_box)
    s_box := box.new(bar_index, s_zone_top, bar_index + retr_win, s_zone_bot,
         border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 85))
if s_state != 2 and not na(s_box)
    box.delete(s_box)
    s_box := na

// Markers
plotshape(not na(sweep_low_lvl),  "SSL Sweep", style=shape.xcross,
     location=location.belowbar, color=color.new(color.green, 30), size=size.tiny)
plotshape(not na(sweep_high_lvl), "BSL Sweep", style=shape.xcross,
     location=location.abovebar, color=color.new(color.red, 30), size=size.tiny)
plotshape(long_fire,  "Long Entry",  style=shape.triangleup,
     location=location.belowbar, color=color.green, size=size.normal)
plotshape(short_fire, "Short Entry", style=shape.triangledown,
     location=location.abovebar, color=color.red, size=size.normal)

if long_fire
    label.new(bar_index, low - atr_val,
         "LONG\nE: "  + str.tostring(close, "#.##") +
         "\nSL: " + str.tostring(long_stop, "#.##") +
         "\nTP: " + str.tostring(long_tgt, "#.##"),
         style=label.style_label_up, color=color.new(color.green, 20),
         textcolor=color.white, size=size.small)

if short_fire
    label.new(bar_index, high + atr_val,
         "SHORT\nE: "  + str.tostring(close, "#.##") +
         "\nSL: " + str.tostring(short_stop, "#.##") +
         "\nTP: " + str.tostring(short_tgt, "#.##"),
         style=label.style_label_down, color=color.new(color.red, 20),
         textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════
//  DASHBOARD
// ═══════════════════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 12,
     bgcolor=color.new(color.black, 75),
     border_color=color.new(color.gray, 60), border_width=1,
     frame_color=color.new(color.gray, 40), frame_width=1)

f_state_txt(st) =>
    st == 1 ? "SWEPT" : st == 2 ? "ARMED" : "—"

if barstate.islast
    table.cell(dash, 0, 0, "SCALP BOT v2", bgcolor=color.new(color.navy, 20),
         text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(close, "#.##"),
         bgcolor=color.new(color.navy, 20), text_color=color.yellow, text_size=size.small)

    table.cell(dash, 0, 1, "BSL", text_color=color.new(color.blue, 20), text_size=size.tiny)
    table.cell(dash, 1, 1, not na(bsl_near) ? str.tostring(bsl_near, "#.##") : "—",
         text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 2, "SSL", text_color=color.new(color.red, 0), text_size=size.tiny)
    table.cell(dash, 1, 2, not na(ssl_near) ? str.tostring(ssl_near, "#.##") : "—",
         text_color=color.white, text_size=size.tiny)
    table.cell(dash, 0, 3, "PDH / PDL", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, str.tostring(pdh, "#.##") + " / " + str.tostring(pdl, "#.##"),
         text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 4, "VWAP", text_color=color.orange, text_size=size.tiny)
    table.cell(dash, 1, 4, close > vwap_val ? "ABOVE ▲" : "BELOW ▼",
         text_color=close > vwap_val ? color.green : color.red, text_size=size.tiny)
    table.cell(dash, 0, 5, "HTF TREND", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, close > htf_ema ? "BULL ▲" : "BEAR ▼",
         text_color=close > htf_ema ? color.green : color.red, text_size=size.tiny)
    table.cell(dash, 0, 6, "RSI", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(math.round(rsi_val, 1)),
         text_color=rsi_val > rsi_hi ? color.red : rsi_val < rsi_lo ? color.green : color.white,
         text_size=size.tiny)
    table.cell(dash, 0, 7, "SESSION", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, in_session ? "ACTIVE ✓" : "CLOSED",
         text_color=in_session ? color.green : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 8, "LONG SETUP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, f_state_txt(l_state),
         text_color=l_state == 2 ? color.lime : l_state == 1 ? color.yellow : color.gray,
         text_size=size.tiny)
    table.cell(dash, 0, 9, "SHORT SETUP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 9, f_state_txt(s_state),
         text_color=s_state == 2 ? color.red : s_state == 1 ? color.yellow : color.gray,
         text_size=size.tiny)

    table.cell(dash, 0, 10, "TRADES TODAY", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 10, str.tostring(trades_today) + "/" + str.tostring(max_daily) +
         "  (L:" + str.tostring(losses_today) + ")",
         text_color=can_trade ? color.white : color.red, text_size=size.tiny)

    pos_txt = strategy.position_size > 0 ? "LONG "  + str.tostring(bars_held) + "b" :
              strategy.position_size < 0 ? "SHORT " + str.tostring(bars_held) + "b" : "FLAT"
    pos_col = strategy.position_size > 0 ? color.lime :
              strategy.position_size < 0 ? color.red : color.gray
    table.cell(dash, 0, 11, "POSITION", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 11, pos_txt, text_color=pos_col, text_size=size.tiny)
